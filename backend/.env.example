# OpenAI official API — used for chat (LLM), vision and embeddings.
# The same key powers ChromaDB memory embeddings (text-embedding-3-small),
# so no local model is ever downloaded or run.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Main agent model (tool calling + streaming; also accepts images)
DEFAULT_MODEL=gpt-6-luna
# Optional: used instead of DEFAULT_MODEL for turns where the user attaches an image
OPENAI_VISION_MODEL=
# Reasoning effort for compatible models; empty disables the parameter
DEFAULT_REASONING_EFFORT=none
# Assistant display name and edge-tts voice
ASSISTANT_NAME=Aura
TTS_VOICE=zh-CN-XiaoyiNeural
# Embedding model for long-term memory (ChromaDB)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web search tool (https://tavily.com)
TAVILY_API_KEY=your-tavily-key

# Maximum total size of cached remote images in MB
MEDIA_CACHE_MAX_MB=500

# Backend bind address; defaults to localhost
BACKEND_HOST=127.0.0.1

# Folder where the create_local_directory tool writes
AURA_WORKSPACE_DIR=~/Desktop/AuraWorkspace

# Optional: comma-separated CORS origins (defaults cover Vite dev + Tauri)
# CORS_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost
