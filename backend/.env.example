# OpenAI official API — used for chat (LLM), vision and embeddings.
# The same key powers ChromaDB memory embeddings (text-embedding-3-small),
# so no local model is ever downloaded or run.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Model roles: provider:model[@reasoning_effort]. Empty = role disabled (its tool is not offered).
# Only "openai" is enabled for chat roles in this version.
MODEL_CONVERSATION=openai:gpt-6-luna@none
MODEL_REPORT=openai:gpt-6.1-terra
MODEL_RESEARCH=openai:gpt-6.2-sol@high
# Used for research when the user turns on 深度模式 in the top bar; empty hides the switch
MODEL_RESEARCH_MAX=openai:gpt-6.2-astra@high
MODEL_VISION=openai:gpt-6.1-terra
# Gemini video and PDF analysis use the Files and Interactions APIs (never get_llm).
# Free-tier uploads may be used to improve Google products and may be human-reviewed;
# the paid tier does not. The app is tier-agnostic and surfaces quota HTTP 429s without retry.
# Files API free-tier limit: 2 GB/file; Google auto-deletes files after 48 hours at most.
# PDF uploads are limited to 50 MB / Google's 1000 pages; PDF_MAX_PAGES=300 reads a
# window of about 156k image tokens. Mercy keeps videos and documents for 15 minutes idle.
# Startup cleans leftovers after an abnormal exit.
# Paid-tier gemini-3.8-flash input: $0.75/1M tokens through 2026-12-31, $1.50/1M from 2027-01-01.
# GEMINI_API_KEY takes precedence; GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=your-gemini-api-key
MODEL_VIDEO=gemini:gemini-3.8-flash
VIDEO_MAX_MINUTES=30
# Maximum PDF pages read per call.
PDF_MAX_PAGES=300
# Gemini files are deleted after 15 minutes idle; 0 deletes immediately.
GEMINI_FILE_RETENTION_SECONDS=900
# Optional one-shot fallback on 429/5xx/timeout before any output, e.g. MODEL_REPORT_FALLBACK=openai:gpt-6-luna
MODEL_CONVERSATION_FALLBACK=
MODEL_REPORT_FALLBACK=
MODEL_RESEARCH_FALLBACK=
MODEL_VISION_FALLBACK=
# Legacy (used only when MODEL_CONVERSATION / MODEL_VISION are empty):
# DEFAULT_MODEL=gpt-6-luna
# DEFAULT_REASONING_EFFORT=none
# OPENAI_VISION_MODEL=
# Assistant display name and edge-tts voice
ASSISTANT_NAME=Aura
TTS_VOICE=zh-CN-XiaoyiNeural
# Embedding model for long-term memory (ChromaDB)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web search tool (https://tavily.com)
TAVILY_API_KEY=your-tavily-key

# Maximum total size of cached remote images in MB
MEDIA_CACHE_MAX_MB=500

# Backend bind address; defaults to localhost
BACKEND_HOST=127.0.0.1

# Folder where the create_local_directory tool writes
AURA_WORKSPACE_DIR=~/Desktop/AuraWorkspace

# Optional: comma-separated CORS origins (also used for media upload/stage mutations)
# "*" is not supported for media upload/stage mutations (those requests get 403).
# CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
